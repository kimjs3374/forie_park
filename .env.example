# 이 파일을 .env 로 복사해서 실제 값 채워넣으세요. (.env 는 git에 올리지 않습니다)

# Flask 세션 암호화 키 — 운영에서는 반드시 무작위 값으로 교체
SECRET_KEY=change-me-to-a-random-secret

# 개발은 비워두면 SQLite 자동 사용.
# 운영(Supabase 등 PostgreSQL) 전환 시 아래 형식으로 지정:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# 세대별 월 무료 주차시간(분). 200시간 = 12000
DEFAULT_MONTHLY_FREE_MINUTES=12000
