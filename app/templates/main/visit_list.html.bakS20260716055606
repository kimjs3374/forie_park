{% extends "base.html" %}
{% block title %}내 방문차량 내역{% endblock %}
{% block content %}
{% if request.args.get('registered') %}
<div class="modal-back" id="regDoneModal" style="z-index:120;">
  <div class="modal-card">
    <div class="modal-title" style="color:var(--primary);">✅ 등록 요청 완료</div>
    <div class="modal-body">방문차량 등록 요청이 접수되었습니다.
잠시 후 목록에서 상태가 <b>등록완료</b>로 바뀌었는지 확인해 주세요.

⚠️ 이용 안내
· 방문차량 등록은 <b>입차만</b> 허용됩니다.
· 오후 8시 이후 숙박(밤샘 주차)을 원하실 경우, 관리사무소 또는 경비실을 경유하여 <b>방문차량증</b>을 작성하시고 앞유리 대시보드 위 잘 보이는 곳에 비치해 주세요.
· 방문차량증이 없는 경우 <b>주차단속 대상</b>이 됩니다.</div>
    <button class="btn-k btn-primary" onclick="document.getElementById('regDoneModal').remove()">확인</button>
  </div>
</div>
{% endif %}
<div class="card-k" style="text-align:center; padding:36px 26px;">
  <p class="sub" style="margin:0;">{{ current_user.household_label }}</p>
  <h1 class="title" style="margin:6px 0 24px; font-size:1.5rem;">{{ current_user.name }}님, 환영합니다</h1>
  <a href="{{ url_for('main.visit_new') }}" class="btn-k btn-primary btn-lg">＋ 방문차량 등록하기</a>
</div>
<div style="text-align:center; color:#ef4444; font-weight:800; font-size:1rem; margin:2px 4px 18px;">
  ※ 입차 후에는 등록을 취소할 수 없습니다
</div>

<div class="section-title">
  <span>내 방문차량 내역</span>
</div>

<div class="stack">
{% if registrations %}
  {% for r in registrations %}
  <div class="item" style="flex-direction:column; align-items:stretch;">
    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
      <div style="min-width:0;">
        <div class="plate">{{ r.car_number }}</div>
        <div class="time" data-inout
             data-in="{{ dispmap.get(r.id, ('',''))[0] }}"
             data-out="{{ dispmap.get(r.id, ('',''))[1] }}"
             data-state="{{ r.visit_state or '' }}">
          예약 {{ r.entry_time.strftime('%Y-%m-%d') }} ~ {{ r.exit_time.strftime('%Y-%m-%d') }}<br>
          입차 <span class="v-in">-</span><br>
          출차 <span class="v-out">-</span><br>
          주차시간 <span class="v-dur">-</span>
        </div>
      </div>
      {% if r.status == 'cancelled' %}
        <span class="badge-k b-cancel">취소됨</span>
      {% elif r.visit_state == 'exited' %}
        <span class="badge-k b-cancel">출차완료</span>
      {% elif r.visit_state == 'entered' %}
        <span class="badge-k b-ok">주차중</span>
      {% elif r.nexpa_registered %}
        <span class="badge-k b-ok">등록완료</span>
      {% else %}
        <span class="badge-k b-wait">등록중</span>
      {% endif %}
    </div>
    {% set sm = summaries.get(r.id) %}
    {% if sm and sm.logs %}
    <details style="margin-top:12px;">
      <summary style="cursor:pointer; font-weight:700; color:var(--primary); list-style:none; font-size:.9rem;">📋 입출차 로그 {{ sm.logs|length }}건 · 총 {{ sm.total_text }}{% if sm.parked_now %} · 주차중{% endif %}</summary>
      <div style="margin-top:8px; border-left:3px solid var(--line,#e5e7eb); padding-left:12px;">
        {% for lg in sm.logs %}
        <div style="display:flex; gap:8px; align-items:center; padding:4px 0;">
          <span class="badge-k {{ 'b-ok' if lg.is_in else 'b-cancel' }}" style="min-width:44px; text-align:center;">{{ '입차' if lg.is_in else '출차' }}</span>
          <span style="font-variant-numeric:tabular-nums; font-weight:600;">{{ lg.event_time_kst.strftime('%m/%d %H:%M') if lg.event_time_kst else '-' }}</span>
        </div>
        {% endfor %}
      </div>
    </details>
    {% endif %}
    {% if r.status == 'active' and not r.visit_state %}
    <form method="post" action="{{ url_for('main.visit_cancel', reg_id=r.id) }}"
          onsubmit="return confirm('등록을 취소하시겠습니까?');" style="margin-top:14px;">
      <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
      <button class="btn-k btn-danger-o">등록 취소</button>
    </form>
    {% elif r.status == 'active' and r.visit_state %}
    <div style="margin-top:14px; text-align:center; color:var(--muted); font-size:.9rem; font-weight:600;">
      입차 후에는 취소할 수 없습니다
    </div>
    {% endif %}
  </div>
  {% endfor %}
{% else %}
  <div class="item" style="justify-content:center; color:var(--muted);">등록된 방문차량이 없습니다.</div>
{% endif %}
</div>
{% endblock %}
